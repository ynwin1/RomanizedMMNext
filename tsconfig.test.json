{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "jsx": "react-jsx",
    "outDir": ".test-dist",
    "rootDir": ".",
    "plugins": []
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "modules/**/*.ts",
    "infrastructure/**/*.ts",
    "integrations/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
